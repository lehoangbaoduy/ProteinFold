{
  "specPrefix": "PFOLD",
  "gatedGlobs": [
    "**/*.py",
    "web/src/**/*.ts"
  ],
  "exemptGlobs": [
    "**/*.md",
    "**/*.lock",
    "**/requirements.txt"
  ],
  "testGlobs": [
    "**/test_*.py",
    "**/*_test.py",
    "web/**/*.test.ts",
    "web/tests/**/*.spec.ts"
  ],
  "testCommands": [
    {
      "globs": [
        "**/*.py"
      ],
      "command": "uv run pytest"
    },
    {
      "globs": [
        "web/**/*.ts"
      ],
      "command": "npm --prefix web test"
    }
  ]
}
