{
  "name": "proteinfold-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Live HP folding with GA, ACO and PSO in the browser (Pyodide) + paper results",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src vite.config.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-security": "^3.0.0",
    "fast-check": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "pyodide": "0.28.3",
    "three": "^0.187.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=20",
    "npm": ">=11"
  }
}
